# Python 분석 서버(python-analysis-server) 환경변수 예시. 실제 값은 .env (Git 제외) 에 작성한다.

# ---- JWT (필수) ----
# 실시간 WebSocket 토큰 검증용. Spring 백엔드(.env.spring.example)와 같은 값이어야 한다.
JWT_SECRET=change-me-to-a-long-random-string-32bytes-or-more

# ---- AWS S3 (Spring 과 같은 변수명) ----
# 로컬 개발에서만 지정한다. 운영 EC2 에서는 이 두 줄을 삭제하고 IAM 역할을 사용한다. (docs/aws-iam-roles.md)
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-2

# ---- Gemini ----
# 없으면 더미 응답 모드로 동작한다.
GEMINI_API_KEY=your-gemini-api-key

# ---- Google STT ----
GOOGLE_STT_ENABLED=false
# 서비스 계정 JSON 경로 (STT 사용 시)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_STT_LANGUAGE_CODE=ko-KR
# ANALYSIS_STT_PROVIDER=google

# ---- LangSmith (선택) ----
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=speakfit
# LANGSMITH_TRACING=false

# ---- 선택 ----
# 브라우저에서 이 서버로 HTTP 요청을 직접 보낼 때만 허용할 프론트 주소를 쉼표로 나열 (기본: 허용 안 함)
# CORS_ALLOWED_ORIGINS=
# LIBREOFFICE_PATH=
