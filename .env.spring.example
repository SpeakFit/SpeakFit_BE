# Spring Boot 백엔드 환경변수 예시. 실제 값은 .env (Git 제외) 에 작성한다.
# 이 파일을 복사해서 사용: cp .env.spring.example .env
#
# [이름 변경 안내] 기존 이름 → 새 이름
#   LOCAL_DB_URL / LOCAL_DB_USERNAME / LOCAL_DB_PASSWORD → DB_HOST, DB_PORT, DB_NAME / DB_USERNAME / DB_PASSWORD
#   JWT_ACCESS_TOKEN_EXP_SECONDS → JWT_ACCESS_EXP_SECONDS
#   JWT_REFRESH_TOKEN_EXP_SECONDS → JWT_REFRESH_EXP_SECONDS

# ---- 실행 프로파일: local | prod ----
SPRING_PROFILES_ACTIVE=local

# ---- DB (local 은 아래 값이 기본값이라 생략 가능, prod 는 HOST/NAME/USERNAME/PASSWORD 필수) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=speakfit
DB_USERNAME=root
DB_PASSWORD=password

# ---- JWT (필수) ----
# 최소 32바이트(256bit) 이상. Python 분석 서버(.env.python.example)와 같은 값을 사용한다.
JWT_SECRET=change-me-to-a-long-random-string-32bytes-or-more
# 선택: access 토큰 1시간(3600), refresh 토큰 14일(1209600)이 기본값
# JWT_ACCESS_EXP_SECONDS=3600
# JWT_REFRESH_EXP_SECONDS=1209600

# ---- AWS S3 (필수) ----
# 로컬 개발에서만 지정한다. 운영 EC2 에서는 이 두 줄을 삭제하고 IAM 역할을 사용한다. (docs/aws-iam-roles.md)
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-northeast-2

# ---- CORS / 서버 간 주소 ----
# local 기본값: CORS=http://localhost:5173,http://localhost:3000 / AI=http://localhost:5000 / WS=ws://localhost:5000/ws/practice
# prod 는 아래 세 가지와 AI_BASE_URL 이 모두 필수 (없으면 기동 실패)
# 허용할 프론트 주소를 쉼표로 나열. 지정하면 기본값을 대체하므로 필요한 주소를 모두 적는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Vercel 프리뷰 등 와일드카드가 꼭 필요할 때만 팀/프로젝트로 좁힌 패턴으로 지정 (credentials 허용 상태이므로 https://*.vercel.app 금지)
# CORS_ALLOWED_ORIGIN_PATTERNS=
# 백엔드가 Python 분석 서버를 호출하는 주소 (서버 간 통신, 내부 주소)
AI_BASE_URL=http://localhost:5000
# 브라우저가 실시간 분석 WebSocket 에 접속하는 주소 (외부에서 접근 가능한 wss 주소)
WS_BASE_URL=ws://localhost:5000/ws/practice

# ---- 선택 ----
# S3_PRESIGN_EXPIRE_SECONDS=3600   # 서명 URL 유효 시간(초)
# JPA_DDL_AUTO=validate   # 스키마는 Flyway 가 관리. 기본값(validate) 그대로 두는 것을 권장
# AI_RESPONSE_TIMEOUT_SECONDS=900
# VOICE_MIN_FILE_SIZE_BYTES=5120
